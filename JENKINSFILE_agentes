pipeline {
    agent none  // Sin agente global; cada stage declara el suyo

    stages {

        stage('Tests') {
            parallel {

                stage('Unit') {
                    agent {
                        node {
                            label 'wd1'
                            customWorkspace "C:\\Users\\josor\\DevOps\\CPs\\workspace\\CP1\\Agentes\\wd1"
                        }
                    }
                    steps {
                        checkout scm
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                            bat '''
                                whoami
                                hostname
                                echo %WORKSPACE%
                                echo STAGE: %STAGE_NAME% / AGENTE: %NODE_NAME%
                                set PYTHONPATH=%WORKSPACE%
                                coverage run --branch --source=app --omit=app\\__init__.py,app\\api.py -m pytest --junitxml=result-unit.xml test\\unit
                            '''
                            junit 'result-unit.xml'
                        }
                        stash name: 'coverage', includes: '.coverage'
                    }
                }

                stage('Static') {
                    agent {
                        node {
                            label 'wd1'
                            customWorkspace "C:\\Users\\josor\\DevOps\\CPs\\workspace\\CP1\\Agentes\\wd1"
                        }
                    }
                    steps {
                        checkout scm
                        bat '''
                            whoami
                            hostname
                            echo %WORKSPACE%
                            echo STAGE: %STAGE_NAME% / AGENTE: %NODE_NAME%
                            bandit --exit-zero -r . -f custom -o bandit.out --msg-template "{abspath}:{line}: [{test_id}] {msg}"
                        '''
                        recordIssues tools: [flake8(name: 'Flake8', pattern: 'flake8.out')],
                                     qualityGates: [[threshold: 8,  type: 'TOTAL', unstable: true],
                                                    [threshold: 10, type: 'TOTAL', unstable: false]]
                    }
                }

                stage('Rest') {
                    agent {
                        node {
                            label 'wd2'
                            customWorkspace "C:\\Users\\josor\\DevOps\\CPs\\workspace\\CP1\\Agentes\\wd2"
                        }
                    }
                    steps {
                        checkout scm
                        bat '''
                            whoami
                            hostname
                            echo %WORKSPACE%
                            echo STAGE: %STAGE_NAME% / AGENTE: %NODE_NAME%
                            set FLASK_APP=app\\api.py
                            set FLASK_ENV=development
                            start flask run
                            start java -jar C:\\Users\\josor\\DevOps\\CPs\\wiremock\\wiremock-standalone-3.13.2.jar --port 9090 --root-dir test\\wiremock
                            set PYTHONPATH=%WORKSPACE%
                            pytest --junitxml=result-rest.xml test\\rest
                        '''
                        junit 'result-rest.xml'
                    }
                }

                stage('Security') {
                    agent {
                        node {
                            label 'wd2'
                            customWorkspace "C:\\Users\\josor\\DevOps\\CPs\\workspace\\CP1\\Agentes\\wd2"
                        }
                    }
                    steps {
                        checkout scm
                        bat 'bandit --exit-zero -r . -f custom -o bandit.out --msg-template "{abspath}:{line}: [{test_id}] {msg}"'
                        recordIssues tools: [pyLint(name: 'Bandit', pattern: 'bandit.out')],
                                     qualityGates: [[threshold: 2, type: 'TOTAL', unstable: true],
                                                    [threshold: 4, type: 'TOTAL', unstable: false]]
                    }
                }

                 stage('Performance'){
                    agent {
                        node {
                            label 'wd3'
                            customWorkspace "C:\\Users\\josor\\DevOps\\CPs\\workspace\\CP1\\Agentes\\wd3"
                        }
                    }
                    steps{
                        checkout scm
                        bat '''
                            whoami
                            hostname
                            echo %WORKSPACE%
                            echo STAGE: %STAGE_NAME% / AGENTE: %NODE_NAME%
                            set FLASK_APP=app\\api.py
                            set FLASK_ENV=development
                            start flask run
                            C:\\Users\\josor\\DevOps\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3\\bin\\jmeter -n -t test\\jmeter\\flask.jmx -l flask.jtl
                        '''

                        perfReport(
                                sourceDataFiles: 'flask.jtl',
                                filterRegex: '',
                                showTrendGraphs: true,
                                percentiles: '90', 
                            )
                    }
                }

                

            }
        }

        stage('Coverage') {
            agent {
                node {
                    label 'wd1'
                    customWorkspace "C:\\Users\\josor\\DevOps\\CPs\\workspace\\CP1\\Agentes\\wd1"
                }
            }
            steps {
                unstash 'coverage'
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    bat 'coverage xml'
                }
                recordCoverage qualityGates: [
                        [integerThreshold: 95, metric: 'LINE',   threshold: 95.0],
                        [criticality: 'ERROR', integerThreshold: 85, metric: 'LINE',   threshold: 85.0],
                        [integerThreshold: 90, metric: 'BRANCH', threshold: 90.0],
                        [criticality: 'ERROR', integerThreshold: 80, metric: 'BRANCH', threshold: 80.0]
                    ],
                    tools: [[parser: 'COBERTURA', pattern: 'coverage.xml']]
            }
        }

        stage('Clean'){
            parallel{
                stage('Clean wd1') {
                    agent {
                        node {
                            label 'wd1'
                            customWorkspace "C:\\Users\\josor\\DevOps\\CPs\\workspace\\CP1\\Agentes\\wd1"
                        }
                    }
                    steps { cleanWs() }
                }

                stage('Clean wd2') {
                    agent {
                        node {
                            label 'wd2'
                            customWorkspace "C:\\Users\\josor\\DevOps\\CPs\\workspace\\CP1\\Agentes\\wd2"
                        }
                    }
                    steps { cleanWs() }
                }

                stage('Clean wd3') {
                    agent {
                        node {
                            label 'wd3'
                            customWorkspace "C:\\Users\\josor\\DevOps\\CPs\\workspace\\CP1\\Agentes\\wd3"
                        }
                    }
                    steps { cleanWs() }
                }
            }
        }

    }
}