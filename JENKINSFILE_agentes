pipeline {
    agent none  // Sin agente global; cada stage declara el suyo

    stages {

        stage('Tests') {
            parallel {

                stage('Unit') {
                    agent { label 'wd1' }
                    steps {
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                            bat '''
                                set PYTHONPATH=%WORKSPACE%
                                coverage run --branch --source=app --omit=app\\__init__.py,app\\api.py -m pytest --junitxml=result-unit.xml test\\unit
                            '''
                            junit 'result-unit.xml'
                        }
                        stash name: 'coverage', includes: '.coverage'
                    }
                }

                stage('Static') {
                    agent { label 'wd1' }
                    steps {
                        bat 'flake8 --exit-zero --format=pylint app 1>flake8.out'
                        recordIssues tools: [flake8(name: 'Flake8', pattern: 'flake8.out')],
                                     qualityGates: [[threshold: 8,  type: 'TOTAL', unstable: true],
                                                    [threshold: 10, type: 'TOTAL', unstable: false]]
                    }
                }

                stage('Security') {
                    agent { label 'wd2' }
                    steps {
                        bat 'bandit --exit-zero -r . -f custom -o bandit.out --msg-template "{abspath}:{line}: [{test_id}] {msg}"'
                        recordIssues tools: [pyLint(name: 'Bandit', pattern: 'bandit.out')],
                                     qualityGates: [[threshold: 2, type: 'TOTAL', unstable: true],
                                                    [threshold: 4, type: 'TOTAL', unstable: false]]
                    }
                }
                

            }
        }

        stage('Coverage') {
            agent { label 'wd1' }
            steps {
                unstash 'coverage'
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    bat 'coverage xml'
                }
                recordCoverage qualityGates: [
                        [integerThreshold: 95, metric: 'LINE',   threshold: 95.0],
                        [criticality: 'ERROR', integerThreshold: 85, metric: 'LINE',   threshold: 85.0],
                        [integerThreshold: 90, metric: 'BRANCH', threshold: 90.0],
                        [criticality: 'ERROR', integerThreshold: 80, metric: 'BRANCH', threshold: 80.0]
                    ],
                    tools: [[parser: 'COBERTURA', pattern: 'coverage.xml']]
            }
        }

        stage('Clean') {
            parallel {
                stage('Clean wd1') {
                    agent { label 'wd1' }
                    steps {
                        bat 'del /f /q result-unit.xml .coverage coverage.xml flake8.out 2>nul'
                    }
                }
                stage('Clean wd2') {
                    agent { label 'wd2' }
                    steps {
                        bat 'del /f /q result-rest.xml bandit.out 2>nul'
                    }
                }
                stage('Clean wd3') {
                    agent { label 'wd3' }
                    steps {
                        bat 'del /f /q flask.jtl 2>nul'
                    }
                }
            }
        }

    }
}